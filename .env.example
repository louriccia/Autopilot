# Copy to .env. Every name the bot reads; values are never committed.

# Discord application (https://discord.com/developers/applications)
token=
clientId=

# Guilds and channels
# The Star Wars: Galactic Racer server
GUILD_ID=
# A private server for trying changes before they go live
TEST_GUILD_ID=
# Where Autopilot reports errors
LOG_CHANNEL_ID=
# Where new members are greeted (needs the Server Members Intent in the Developer Portal)
WELCOME_CHANNEL_ID=

# true routes the bot to TEST_GUILD_ID only; false serves everything else.
# Leave blank to switch on automatically when USERNAME is louri.
TESTING=
# More servers a testing copy serves (comma-separated); the live bot leaves them alone
TESTING_GUILDS=
# Roles whose members may submit and remove times for others (comma-separated), alongside /submitter
SUBMITTER_ROLE_IDS=
# Arcade runs posted here as YouTube links are saved as times (#holo-replays)
REPLAY_CHANNEL_ID=
# Video details for replays: a YouTube Data API v3 key
YOUTUBE_API_KEY=
# Reading screenshots in the replay channel
OPENAI_API_KEY=
OPENAI_MODEL=

# Announcement feeds (src/feeds). A feed with no channel doesn't run.
# Steam builds and official announcements / patch notes
PATCH_CHANNEL_ID=
# YouTube uploads
VIDEO_CHANNEL_ID=
# Twitch streams of the game (needs TWITCH_ID / TWITCH_SECRET, a Twitch app from dev.twitch.tv/console)
STREAM_CHANNEL_ID=
TWITCH_ID=
TWITCH_SECRET=
# Viewers a stream needs before it's announced (default 10; the category has ~100 live at a time)
TWITCH_MIN_VIEWERS=
# Stream languages to announce, as Twitch codes (comma-separated; default en; blank line value = any)
TWITCH_LANGUAGES=
# Where a testing copy posts every feed instead
TEST_CHANNEL_ID=
# YouTube channel ids to watch (comma-separated); blank = the game's official channel
YOUTUBE_CHANNELS=

# Firebase Realtime Database (project autopilot-swgr): the firebase-adminsdk service account's key
# (Firebase console > Project settings > Service accounts > Generate new private key).
# FIREBASE_PRIVATE_KEY is the key on one line with \n for line breaks, in quotes.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_DATABASE_URL=
