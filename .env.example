# Copy to .env. Every name the bot reads; values are never committed.

# Discord application (https://discord.com/developers/applications)
token=
clientId=

# Guilds and channels
# The Star Wars: Galactic Racer server
GUILD_ID=
# A private server for trying changes before they go live
TEST_GUILD_ID=
# Where Autopilot reports errors
LOG_CHANNEL_ID=

# true routes the bot to TEST_GUILD_ID only; false serves everything else.
# Leave blank to switch on automatically when USERNAME is louri.
TESTING=
